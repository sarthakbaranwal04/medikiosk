# ---- Application ----
APP_NAME="Patient Case Taking Software"
APP_ENV=development
DEBUG=true

# ---- Database ----
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/patient_case_db

# ---- Security / JWT (added in Phase 2, present here so .env is stable across phases) ----
JWT_SECRET_KEY=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- CORS ----
# Comma-separated list of allowed origins for the React kiosk/doctor clients
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- File storage (used from Phase 4 onward) ----
UPLOAD_DIR=./uploads

# ---- Speech service (used from Phase 5 onward) ----
SPEECH_PROVIDER=bhashini
BHASHINI_API_KEY=
BHASHINI_USER_ID=
WHISPER_API_KEY=

# ---- Logging ----
LOG_LEVEL=INFO
